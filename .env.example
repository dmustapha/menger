# MENGER — environment template
#
# Copy to .env and adjust only if your setup differs from the defaults below.
# Every value here matches a real os.getenv() in app/config.py or the frontend.
# The engine takes NO credentials: FalkorDB is local, container-local and
# unauthenticated by design (synthetic data only). Nothing in this file is a secret.

# =============================================================================
# ENGINE — read by the FastAPI service (app/config.py)
# =============================================================================

# FalkorDB connection URI. Default assumes the pinned local container.
# Do NOT stop, restart or `docker rm` gh-falkor while the demo is live — it is the build DB.
MENGER_REDIS_URL=redis://localhost:6379

# Graph key the engine reads and writes. Appears in receipts as engine.graph and in /health.
# NOTE: `python3 -m app.seed` DELETES and rebuilds this graph. Point it elsewhere to seed safely.
MENGER_GRAPH=menger

# Verdict epsilon band (server constant, published by GET /health, echoed on every decision).
# The console must NOT hold its own copy — it reads this from /health.
MENGER_EPSILON=0.05

# Recency decay per hour: recency = exp(-lambda * age_hours).
# RULE: re-seed the trusts, never re-tune lambda — tuning a published constant to shift a
# demo outcome is the one thing the system must never do. /health is the runtime source of truth.
MENGER_LAMBDA_PER_HOUR=0.0080

# =============================================================================
# CONSOLE — read at BUILD time by the Next.js frontend (frontend/src/lib/api.ts)
# =============================================================================

# Base URL the console calls. NEXT_PUBLIC_* is inlined at build time, so set it before
# `npm run build`. Leave as the local default for local dev; the live console builds with
# https://api.leash.ink/menger.
# WARNING: on some hosts `localhost` resolves to ::1 and can hit the wrong server — prefer
# 127.0.0.1 if you see the console talking to something unexpected.
NEXT_PUBLIC_MENGER_API=http://localhost:8000
