# MENGER — environment template
#
# Copy to .env and fill. NEVER commit a filled .env.
#
# WHAT THIS FILE IS, AND THE ONE RULE IT OBEYS
# --------------------------------------------
# This file is reconciled BOTH DIRECTIONS against .input-manifest.json:
#   (a) every variable declared here has a matching `.inputs[].id`, and
#   (b) every `.inputs[].id` in the manifest is declared here.
# An under-declared variable is a gate failure. So is a manifest row with no line here:
# that is how a phase blocks mid-run on an input nobody gated (R1).
# Row count both sides: 10.
#
# THE ENGINE TAKES NO CREDENTIALS.
# FalkorDB is local, container-local and unauthenticated (AF-9). Nothing in the
# ENGINE block below is a secret. The only credential-bearing rows are deploy-side,
# in the DEPLOY block, and they are deliberately empty here.
#
# CLAIM STATE: `resolved` rows carry values measured or ruled upstream and cited.
# `unresolved` rows are NOT_CLAIMED and name the phase that must resolve them.
# Nothing here is invented; where a value does not exist yet, the line is empty.
#
# Verify this file:
#   bash /Users/MAC/pipeline-2b-worktree/utils/manifest-lint.sh /Users/MAC/graph-hacks
#
# FOUR ROWS ARE NOT SHELL-SHAPED, ON PURPOSE.
# `falkordb_python_client`, `seed_dataset`, `boot_assertion_constants` and
# `submission_form_session` are lowercase because they are manifest JOIN KEYS, not
# process environment in the usual sense — they are pinned choices and artifacts that
# a phase must have resolved. They are declared here because the reconciliation is by
# id and must close in both directions. Renaming them to SCREAMING_CASE would break
# the join against the frozen manifest v1.0; if a future manifest v1.1 normalises the
# naming, this file follows it. Reading them as shell env is harmless: the engine
# reads only the five rows marked ENGINE-READ below.


# =============================================================================
# ENGINE — local, no credentials. Read by the FastAPI service at startup.
# =============================================================================

# ENGINE-READ. FalkorDB connection URI.
#   manifest: FALKORDB_URL — required, resolved by `intel`
#   value is measured: container gh-falkor, image falkordb/falkordb:v4.22.1 [VERIFIED: AF-9]
#   Unauthenticated by design (local/demo, synthetic data only). No password component.
#   Do NOT stop, restart or `docker rm` gh-falkor — it is the live build DB.
FALKORDB_URL=redis://localhost:6379

# ENGINE-READ. Graph key the engine reads and writes.
#   manifest: FALKORDB_GRAPH_NAME — required, resolved by `forge`
#   Appears in receipts as `engine.graph` and in /health as `engine.graph` (CONTRACT §2.5, §2.8).
FALKORDB_GRAPH_NAME=menger

# ENGINE-READ (as a pin, not a connection string). The client library on the read path.
#   manifest: falkordb_python_client — required, resolved by `warroom`
#   LOAD-BEARING: all reads go through GRAPH.RO_QUERY, the server-side containment
#   boundary for generated Cypher (CREATE rejected, MATCH allowed) [VERIFIED: AF-8].
#   Only the Python client exposes it; the TS client does not (FalkorDB issue #408).
#   This is why the stack is Python — not a preference. Changing this value silently
#   removes the containment that FEATURE-OBSERVABLES F-11 and the replay guarantee rest on.
falkordb_python_client=falkordb-py

# ENGINE-READ. Path to the synthetic seeded provenance corpus, committed in-repo.
#   manifest: seed_dataset — required, UNRESOLVED, owner `build`
#   Synthetic and fresh only: no private data, no real user data, nothing ported.
#   Must contain the three set-pieces: the echo (independence 1), the independent pair
#   (independence 2), and a deliberate near-tie that lands UNDECIDED in the review queue.
#   Filename is build's to choose; this line exists so no phase blocks on it.
#   NOT_CLAIMED until build emits the file.
seed_dataset=

# ENGINE-READ. The three boot assertions /health must reproduce or refuse to serve.
#   manifest: boot_assertion_constants — required, resolved by `warroom`
#   MEASURED UPSTREAM, NOT CONFIGURATION. node_split_echo=1 and
#   node_split_independent=2 [VERIFIED: AF-6]; sp_path_weight=0.21072 [VERIFIED: AF-3].
#   On any mismatch /health returns 503 BOOT_ASSERTION_FAILED (AF-16) — the service
#   refuses to serve rather than serve a wrong headline number.
#   DO NOT TUNE THESE TO MAKE A BUILD PASS. An expected value fitted to a running
#   system asserts nothing; that is the false-PASS in FEATURE-OBSERVABLES §3.1.
#   Declared here as the pinned triple so a drift is a diff, not a surprise.
boot_assertion_constants=node_split_echo=1,node_split_independent=2,sp_path_weight=0.21072


# =============================================================================
# SERVER CONSTANTS — calibrated in the build phase, then PUBLISHED by GET /health.
# The console MUST NOT hardcode either of these (AF-17 / DS-8 / R-4).
# =============================================================================

# Verdict epsilon band. Server constant; echoed on every decision.
#   manifest: EPSILON_BAND — required, UNRESOLVED, owner `build`
#   Decision rule (CONTRACT §2.1, normative):
#     margin  >  +epsilon  -> ALLOW      ADMITTED   review_id null
#     margin  <  -epsilon  -> BLOCK      REFUSED    review_id null
#     |margin| <= epsilon  -> UNDECIDED  QUEUED     review_id set
#   Starting value under discussion is 0.05, [ASSUMED] and UNMEASURED. It is left
#   BLANK here deliberately: writing 0.05 into a template is how a proposed default
#   becomes a quoted fact. Calibrate in build against the seeded corpus, then publish.
#   Sanity floor: epsilon=0 makes UNDECIDED unreachable and empties the review queue.
#   NOT_CLAIMED.
EPSILON_BAND=

# Recency decay constant, per hour: recency = exp(-lambda * age_hours).
#   manifest: RECENCY_LAMBDA — required, UNRESOLVED, owner `build`
#   CONTRADICTION BETWEEN SOURCES, flagged not resolved: PLAN.md §5 and the redo brief
#   give 0.01/hour [ASSUMED]; CONTRACT.md's illustrative examples show `lambda: 0.0077`.
#   Neither is measured. The operative rule is not a number — read lambda from
#   GET /health and never copy it from a document, this one included.
#   Left blank for the same reason as EPSILON_BAND. NOT_CLAIMED.
RECENCY_LAMBDA=


# =============================================================================
# DEPLOY — the ONLY credential-bearing rows. Not needed to run the engine locally.
# =============================================================================

# Platform credential for the durable hosting tier.
#   manifest: RENDER_API_KEY — tier deferred-until-deploy, UNRESOLVED, owner `deploy`
#   SECRET. Never commit a filled value; never paste it into a doc, a prompt or a video.
#   Gated on spend: durability-tier.json records spendApproved=false — the starter
#   tier plus persistent disk is a cost decision and is Dami's call at deploy (cost-A).
#   NOT_CLAIMED.
RENDER_API_KEY=

# The reachable live URL the README, the video and the submission form all cite.
#   manifest: PUBLIC_BASE_URL — tier deferred-until-deploy, UNRESOLVED, owner `deploy`
#   Not a secret. Substitutes for http://localhost:8000 in every check in
#   FEATURE-OBSERVABLES.md; nothing else changes, because every check is plain HTTP
#   against the 8 frozen endpoints. Re-run F-11's engine half against the deployed
#   instance — RO_QUERY containment is VERIFIED only for gh-falkor / v4.22.1 and does
#   not transfer by assumption. NOT_CLAIMED until a URL answers.
PUBLIC_BASE_URL=

# Logged-in session for the Graph Hacks submission SPA.
#   manifest: submission_form_session — tier deferred-until-verify_preflight,
#   UNRESOLVED, owner `verify_preflight`
#   SECRET, AND DELIBERATELY UNFILLABLE HERE. Login-gated; it must be read in the real
#   browser session, which is a singleton. Do NOT paste a cookie or bearer token into
#   this file or any artifact — a session token in a repo is a submission-ending defect.
#   Declared only so the reconciliation closes and no phase discovers it at the wire.
#   NOT_CLAIMED.
submission_form_session=


# =============================================================================
# RECONCILIATION — 10 variables here, 10 `.inputs[].id` in .input-manifest.json v1.0.
#
#   FALKORDB_URL ................ resolved  · intel
#   FALKORDB_GRAPH_NAME ......... resolved  · forge
#   falkordb_python_client ...... resolved  · warroom
#   seed_dataset ................ UNRESOLVED · build
#   boot_assertion_constants .... resolved  · warroom
#   EPSILON_BAND ................ UNRESOLVED · build
#   RECENCY_LAMBDA .............. UNRESOLVED · build
#   RENDER_API_KEY .............. UNRESOLVED · deploy            (secret)
#   PUBLIC_BASE_URL ............. UNRESOLVED · deploy
#   submission_form_session ..... UNRESOLVED · verify_preflight  (secret)
#
# No variable here lacks a manifest row. No manifest row lacks a line here.
# =============================================================================
